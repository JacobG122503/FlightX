# FlightX needs no keys — everything works out of the box. These are all optional.

# Port for the built-in flight data service.
PORT=8787

# Free OpenSky Network account: the zoomed-out world view then refreshes every 30s
# instead of 90s, with 10x the daily allowance (anonymous ≈ 2.5 h of use per day).
# Create an API client at https://opensky-network.org/my-opensky/account
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# How often (seconds) to refresh the world view. Defaults: 90 anonymous, 30 with an account.
# OPENSKY_REFRESH_SECONDS=

# Your contact URL or email, sent to Planespotters.net so the server may fetch aircraft
# photos too (their API policy). Without it, photos still load via other routes.
# PLANESPOTTERS_CONTACT=https://github.com/your-username
